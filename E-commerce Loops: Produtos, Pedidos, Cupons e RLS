-- Vendas por dia
CREATE OR REPLACE VIEW public.vw_sales_by_day AS
SELECT date_trunc('day', sold_at)::date AS dia,
       COUNT(DISTINCT order_id)         AS pedidos,
       SUM(qty)                         AS itens,
       SUM(line_total)                  AS faturamento
FROM public.sales_history GROUP BY 1 ORDER BY 1 DESC;

-- Vendas por mês
CREATE OR REPLACE VIEW public.vw_sales_by_month AS
SELECT to_char(date_trunc('month', sold_at), 'YYYY-MM') AS mes,
       COUNT(DISTINCT order_id)                         AS pedidos,
       SUM(qty)                                         AS itens,
       SUM(line_total)                                  AS faturamento
FROM public.sales_history GROUP BY 1 ORDER BY 1 DESC;

-- Vendas por produto
CREATE OR REPLACE VIEW public.vw_sales_by_product AS
SELECT product_id, product_name,
       SUM(qty)        AS qtd_vendida,
       SUM(line_total) AS faturamento
FROM public.sales_history GROUP BY product_id, product_name ORDER BY qtd_vendida DESC;

-- Produtos mais vendidos (top 50)
CREATE OR REPLACE VIEW public.vw_top_products AS
SELECT product_id, product_name, SUM(qty) AS qtd_vendida, SUM(line_total) AS faturamento
FROM public.sales_history GROUP BY product_id, product_name
ORDER BY qtd_vendida DESC LIMIT 50;

-- Faturamento total
CREATE OR REPLACE VIEW public.vw_revenue_total AS
SELECT COALESCE(SUM(line_total),0) AS faturamento_total,
       COUNT(DISTINCT order_id)    AS total_pedidos,
       COALESCE(SUM(qty),0)        AS total_itens
FROM public.sales_history;

-- Estoque baixo (acima de 0 e até o limite configurado)
CREATE OR REPLACE VIEW public.vw_low_stock AS
SELECT id, name, stock FROM public.products
WHERE active = true AND stock > 0
  AND stock <= COALESCE((SELECT value::int FROM public.settings WHERE key='low_stock_threshold'), 5)
ORDER BY stock ASC;

-- Estoque zerado
CREATE OR REPLACE VIEW public.vw_zero_stock AS
SELECT id, name, stock FROM public.products WHERE stock <= 0 ORDER BY name;

-- PIX por situação
CREATE OR REPLACE VIEW public.vw_pix_pending AS
SELECT * FROM public.pix_transactions WHERE status = 'aguardando_pagamento' ORDER BY created_at DESC;
CREATE OR REPLACE VIEW public.vw_pix_expired AS
SELECT * FROM public.pix_transactions WHERE status = 'expirado' ORDER BY created_at DESC;
CREATE OR REPLACE VIEW public.vw_pix_approved AS
SELECT * FROM public.pix_transactions WHERE status = 'aprovado' ORDER BY updated_at DESC;


