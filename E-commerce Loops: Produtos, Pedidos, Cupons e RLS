    cart_token      UUID UNIQUE NOT NULL,
    customer_name   TEXT,
    customer_phone  TEXT,
    items           JSONB,                 -- [{product_id, product_name, qty, unit_price}]
    item_count      INTEGER DEFAULT 0,
    estimated_value NUMERIC(10,2) DEFAULT 0, -- recalculado no servidor
    status          TEXT DEFAULT 'aberto', -- aberto | convertido | descartado
    order_id        BIGINT,
    created_at      TIMESTAMPTZ DEFAULT NOW(),
    updated_at      TIMESTAMPTZ DEFAULT NOW()
