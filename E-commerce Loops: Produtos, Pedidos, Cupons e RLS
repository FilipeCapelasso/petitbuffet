-- ─── 4.1 place_order — cria o pedido e os itens. NÃO baixa estoque aqui!  ──────
--     (a baixa acontece só quando o pagamento é APROVADO — ver confirm_payment)
--     Retorna: { success, order_id, order_number }
-- Remove versões antigas (evita erro 42P13 "cannot remove parameter defaults").
DROP FUNCTION IF EXISTS public.place_order(jsonb, jsonb, text);
DROP FUNCTION IF EXISTS public.place_order(jsonb, jsonb);

CREATE OR REPLACE FUNCTION public.place_order(
  p_order JSONB,
  p_items JSONB
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER
SET search_path = public AS $$
DECLARE
  v_order_id BIGINT;
  v_number   TEXT;
  v_item     JSONB;
BEGIN
  INSERT INTO public.orders (customer_name, customer_phone, delivery_type, address, total)
  VALUES (
    p_order->>'customer_name',
    p_order->>'customer_phone',
    p_order->>'delivery_type',
    p_order->>'address',
    (p_order->>'total')::numeric
  )
  RETURNING id, order_number INTO v_order_id, v_number;

  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items)
  LOOP
    INSERT INTO public.order_items (order_id, product_id, product_name, qty, unit_price)
    VALUES (
      v_order_id,
      (v_item->>'product_id')::bigint,
      v_item->>'product_name',
      (v_item->>'qty')::int,
      (v_item->>'unit_price')::numeric
    );
  END LOOP;

  RETURN jsonb_build_object('success', true, 'order_id', v_order_id, 'order_number', v_number);
END;
$$;
GRANT EXECUTE ON FUNCTION public.place_order(JSONB, JSONB) TO anon, authenticated;

-- compatibilidade: se algo ainda chamar place_order com 3 argumentos (cupom),
-- ignoramos o 3º e chamamos a versão nova. Assim nada quebra.
CREATE OR REPLACE FUNCTION public.place_order(
  p_order JSONB, p_items JSONB, p_coupon TEXT
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER
SET search_path = public AS $$
BEGIN
  RETURN public.place_order(p_order, p_items);
END;
$$;
GRANT EXECUTE ON FUNCTION public.place_order(JSONB, JSONB, TEXT) TO anon, authenticated;

-- ─── 4.2 get_payment_status — navegador consulta o status com token  ──────────
DROP FUNCTION IF EXISTS public.get_payment_status(bigint, uuid);
CREATE OR REPLACE FUNCTION public.get_payment_status(
  p_order_id BIGINT,
  p_token    UUID
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER
SET search_path = public AS $$
DECLARE r public.pix_transactions;
BEGIN
  SELECT * INTO r FROM public.pix_transactions
   WHERE order_id = p_order_id AND access_token = p_token
   ORDER BY id DESC LIMIT 1;

  IF NOT FOUND THEN RETURN jsonb_build_object('found', false); END IF;

  RETURN jsonb_build_object(
    'found', true, 'order_id', r.order_id, 'status', r.status,
    'amount', r.amount, 'expires_at', r.expires_at
  );
END;
$$;
GRANT EXECUTE ON FUNCTION public.get_payment_status(BIGINT, UUID) TO anon, authenticated;

-- ─── 4.3 confirm_payment — O CORAÇÃO DA AUTOMAÇÃO (transacional)  ──────────────
--   Chamada pela Edge Function quando o Mercado Pago confirma algo.
--   Quando vira 'aprovado' pela 1ª vez, em UMA transação:
--     1) atualiza pix_transactions   2) atualiza orders (status + paid_at)
--     3) baixa products.stock         4) grava inventory_logs
--     5) grava sales_history          6) grava system_logs
--   Se QUALQUER passo falhar, o PostgreSQL desfaz TUDO (rollback automático).
--   É idempotente: se o webhook chegar 2x, não baixa estoque duas vezes.
CREATE OR REPLACE FUNCTION public.confirm_payment(
  p_mp_payment_id TEXT,
  p_status        TEXT,
  p_raw           JSONB DEFAULT NULL
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER
SET search_path = public AS $$
DECLARE
  v_tx      public.pix_transactions;
  v_from    TEXT;
  v_order   public.orders;
  v_item    RECORD;
  v_balance INTEGER;
BEGIN
  SELECT * INTO v_tx FROM public.pix_transactions WHERE mp_payment_id = p_mp_payment_id LIMIT 1;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('ok', false, 'reason', 'payment_not_found');
  END IF;

  v_from := v_tx.status;

  -- nada muda
  IF v_from = p_status THEN
    RETURN jsonb_build_object('ok', true, 'unchanged', true, 'status', p_status);
  END IF;

  -- já aprovado/reembolsado: não regride por notificação atrasada (evita baixa dupla)
  IF v_from IN ('aprovado','reembolsado') AND p_status NOT IN ('reembolsado') THEN
    RETURN jsonb_build_object('ok', true, 'ignored', true, 'status', v_from);
  END IF;

  -- atualiza a transação PIX e o pedido
  UPDATE public.pix_transactions
     SET status = p_status, raw = COALESCE(p_raw, raw), updated_at = NOW()
   WHERE id = v_tx.id;

  UPDATE public.orders
     SET status = p_status,
         paid_at = CASE WHEN p_status = 'aprovado' THEN NOW() ELSE paid_at END,
         updated_at = NOW()
   WHERE id = v_tx.order_id
   RETURNING * INTO v_order;

  -- ►► APROVAÇÃO (1ª vez): baixa de estoque + históricos, tudo transacional ◄◄
  IF p_status = 'aprovado' AND v_from <> 'aprovado' THEN
    FOR v_item IN
      SELECT * FROM public.order_items WHERE order_id = v_tx.order_id
    LOOP
      IF v_item.product_id IS NOT NULL THEN
        UPDATE public.products
           SET stock = GREATEST(0, COALESCE(stock,0) - v_item.qty)
         WHERE id = v_item.product_id
         RETURNING stock INTO v_balance;

        INSERT INTO public.inventory_logs (product_id, product_name, change, reason, order_id, balance_after)
        VALUES (v_item.product_id, v_item.product_name, -v_item.qty, 'venda', v_tx.order_id, v_balance);
      END IF;

      INSERT INTO public.sales_history (order_id, order_number, product_id, product_name, qty, unit_price, line_total)
      VALUES (v_tx.order_id, v_order.order_number, v_item.product_id, v_item.product_name,
              v_item.qty, v_item.unit_price, ROUND(v_item.qty * v_item.unit_price, 2));
    END LOOP;

    INSERT INTO public.system_logs (level, scope, message, data)
    VALUES ('info', 'pix', 'Pagamento aprovado e estoque baixado',
            jsonb_build_object('order_id', v_tx.order_id, 'order_number', v_order.order_number, 'mp_payment_id', p_mp_payment_id));
  ELSE
    INSERT INTO public.system_logs (level, scope, message, data)
    VALUES ('info', 'pix', 'Status do pagamento atualizado',
            jsonb_build_object('order_id', v_tx.order_id, 'from', v_from, 'to', p_status));
  END IF;

  RETURN jsonb_build_object('ok', true, 'order_id', v_tx.order_id,
                            'order_number', v_order.order_number, 'from', v_from, 'to', p_status);
END;
$$;
-- (sem GRANT para anon: só a Edge Function usa, via service role)

-- ─── 4.4 expire_pending_pix — marca como expirado o que passou da validade  ───
--     (a Edge Function pode chamar; ou rode manualmente quando quiser limpar)
CREATE OR REPLACE FUNCTION public.expire_pending_pix()
RETURNS INTEGER LANGUAGE plpgsql SECURITY DEFINER
SET search_path = public AS $$
DECLARE n INTEGER;
BEGIN
  WITH upd AS (
    UPDATE public.pix_transactions
       SET status = 'expirado', updated_at = NOW()
     WHERE status = 'aguardando_pagamento'
       AND expires_at IS NOT NULL AND expires_at < NOW()
    RETURNING order_id
  )
  UPDATE public.orders o SET status = 'expirado', updated_at = NOW()
   FROM upd WHERE o.id = upd.order_id AND o.status = 'aguardando_pagamento';
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n;
END;
$$;


