-- 6. place_order — cria o pedido (status = pendente) com os campos profissionais
--    Mantém compatibilidade total com as chamadas atuais (2 e 3 argumentos).
-- ███████████████████████████████████████████████████████████████████████████
DROP FUNCTION IF EXISTS public.place_order(jsonb, jsonb);
CREATE OR REPLACE FUNCTION public.place_order(
  p_order JSONB,
  p_items JSONB
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE
  v_order_id BIGINT;
  v_number   TEXT;
  v_item     JSONB;
BEGIN
  INSERT INTO public.orders
    (customer_name, customer_phone, delivery_type, address, total,
     subtotal, shipping, customer_ip, customer_device, sale_source, cart_token, status)
  VALUES (
    p_order->>'customer_name',
    p_order->>'customer_phone',
    p_order->>'delivery_type',
    p_order->>'address',
    (p_order->>'total')::numeric,
    NULLIF(p_order->>'subtotal','')::numeric,
    COALESCE(NULLIF(p_order->>'shipping','')::numeric, 0),
    p_order->>'customer_ip',
    p_order->>'customer_device',
    COALESCE(NULLIF(p_order->>'sale_source',''), 'site'),
    NULLIF(p_order->>'cart_token','')::uuid,
    'pendente'
  )
  RETURNING id, order_number INTO v_order_id, v_number;

  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items)
  LOOP
    INSERT INTO public.order_items (order_id, product_id, product_name, qty, unit_price)
    VALUES (
      v_order_id,
      (v_item->>'product_id')::bigint,
      v_item->>'product_name',
      (v_item->>'qty')::int,
      (v_item->>'unit_price')::numeric
    );
  END LOOP;

  RETURN jsonb_build_object('success', true, 'order_id', v_order_id, 'order_number', v_number);
END;
$$;
GRANT EXECUTE ON FUNCTION public.place_order(JSONB, JSONB) TO anon, authenticated;

