-- salva/atualiza um carrinho abandonado. PREÇO/VALOR é recalculado no servidor
-- a partir do catálogo (nunca confia no que o navegador enviou).
CREATE OR REPLACE FUNCTION public.save_abandoned_cart(
  p_token UUID,
  p_name  TEXT,
  p_phone TEXT,
  p_items JSONB              -- [{product_id, qty}]
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE
  v_item   JSONB;
  v_pid    BIGINT;
  v_qty    INTEGER;
  v_price  NUMERIC(10,2);
  v_pname  TEXT;
  v_clean  JSONB := '[]'::jsonb;
  v_total  NUMERIC(10,2) := 0;
  v_count  INTEGER := 0;
  v_status TEXT;
BEGIN
  -- não reabre carrinho já convertido em venda
  SELECT status INTO v_status FROM public.abandoned_carts WHERE cart_token = p_token;
  IF v_status = 'convertido' THEN
    RETURN jsonb_build_object('ok', true, 'status', 'convertido');
  END IF;

  FOR v_item IN SELECT * FROM jsonb_array_elements(COALESCE(p_items,'[]'::jsonb))
  LOOP
    v_pid := NULLIF(v_item->>'product_id','')::bigint;
    v_qty := GREATEST(1, COALESCE((v_item->>'qty')::int, 1));
    IF v_pid IS NULL THEN CONTINUE; END IF;

    SELECT name, COALESCE(sale, orig) INTO v_pname, v_price
    FROM public.products WHERE id = v_pid AND active = true;
    IF NOT FOUND THEN CONTINUE; END IF;

    v_total := v_total + (v_price * v_qty);
    v_count := v_count + v_qty;
    v_clean := v_clean || jsonb_build_object(
      'product_id', v_pid, 'product_name', v_pname,
      'qty', v_qty, 'unit_price', v_price);
  END LOOP;

  IF v_count = 0 THEN
    RETURN jsonb_build_object('ok', false, 'reason', 'empty');
  END IF;

  INSERT INTO public.abandoned_carts
    (cart_token, customer_name, customer_phone, items, item_count, estimated_value, status, updated_at)
  VALUES
    (p_token, p_name, public.only_digits(p_phone), v_clean, v_count, v_total, 'aberto', NOW())
  ON CONFLICT (cart_token) DO UPDATE SET
    customer_name   = COALESCE(EXCLUDED.customer_name, public.abandoned_carts.customer_name),
    customer_phone  = COALESCE(NULLIF(EXCLUDED.customer_phone,''), public.abandoned_carts.customer_phone),
    items           = EXCLUDED.items,
    item_count      = EXCLUDED.item_count,
    estimated_value = EXCLUDED.estimated_value,
    status          = 'aberto',
    updated_at      = NOW();

  RETURN jsonb_build_object('ok', true, 'estimated_value', v_total, 'item_count', v_count);
END;
$$;
GRANT EXECUTE ON FUNCTION public.save_abandoned_cart(UUID, TEXT, TEXT, JSONB) TO anon, authenticated;

-- marca como convertido (chamado quando o pagamento é aprovado)
