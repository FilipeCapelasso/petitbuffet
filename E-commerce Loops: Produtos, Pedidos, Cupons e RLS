-- ███████████████████████████████████████████████████████████████████████████
-- 3. NUMERAÇÃO DE PEDIDO AUTOMÁTICA (LP-2026-0003143)
--    Um gatilho coloca o número em todo pedido novo. Começa em 3143 (como o exemplo).
-- ███████████████████████████████████████████████████████████████████████████
CREATE SEQUENCE IF NOT EXISTS public.order_number_seq START 3143;

CREATE OR REPLACE FUNCTION public.set_order_number()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
DECLARE v_prefix TEXT; v_n BIGINT;
BEGIN
  IF NEW.order_number IS NULL THEN
    v_prefix := COALESCE((SELECT value FROM public.settings WHERE key = 'order_prefix'), 'LP');
    v_n := nextval('public.order_number_seq');
    NEW.order_number := v_prefix || '-' || to_char(NOW(), 'YYYY') || '-' || lpad(v_n::text, 7, '0');
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_set_order_number ON public.orders;
CREATE TRIGGER trg_set_order_number
  BEFORE INSERT ON public.orders
  FOR EACH ROW EXECUTE FUNCTION public.set_order_number();


