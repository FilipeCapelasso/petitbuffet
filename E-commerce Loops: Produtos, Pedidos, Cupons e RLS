-- 11. VIEWS PARA O PAINEL (lista de pedidos, funil de conversão, recuperação)
--     security_invoker = respeita o RLS (admin lê tudo; anon não lê nada).
-- ███████████████████████████████████████████████████████████████████████████
-- lista de pedidos com resumo de itens (sem N+1 no front)
CREATE OR REPLACE VIEW public.vw_orders_admin
WITH (security_invoker = true) AS
SELECT o.*,
  (SELECT string_agg(oi.product_name || ' ×' || oi.qty, ', ')
     FROM public.order_items oi WHERE oi.order_id = o.id) AS items_summary,
  (SELECT COALESCE(SUM(oi.qty),0)
     FROM public.order_items oi WHERE oi.order_id = o.id) AS items_count
FROM public.orders o;
GRANT SELECT ON public.vw_orders_admin TO authenticated;

-- funil de conversão (uma linha com todos os indicadores)
CREATE OR REPLACE VIEW public.vw_conversion_funnel
WITH (security_invoker = true) AS
SELECT
  (SELECT count(*) FROM public.analytics_events WHERE type = 'cart_created')      AS carrinhos_criados,
  (SELECT count(*) FROM public.analytics_events WHERE type = 'checkout_started')  AS checkouts_iniciados,
  (SELECT count(*) FROM public.pix_transactions)                                  AS pix_gerados,
  (SELECT count(*) FROM public.pix_transactions WHERE public.norm_status(status)='pago') AS pix_pagos,
  (SELECT count(*) FROM public.orders WHERE public.norm_status(status) IN ('pago','em_separacao','enviado','concluido')) AS pedidos_pagos,
  (SELECT count(*) FROM public.orders WHERE public.norm_status(status) = 'concluido') AS pedidos_concluidos,
  (SELECT count(*) FROM public.abandoned_carts WHERE status = 'aberto')           AS carrinhos_abertos,
  (SELECT COALESCE(SUM(estimated_value),0) FROM public.abandoned_carts WHERE status = 'aberto') AS valor_recuperavel;
GRANT SELECT ON public.vw_conversion_funnel TO authenticated;

-- carrinhos abandonados (em aberto) para contato
CREATE OR REPLACE VIEW public.vw_abandoned_carts
WITH (security_invoker = true) AS
SELECT * FROM public.abandoned_carts
WHERE status = 'aberto' AND item_count > 0
ORDER BY updated_at DESC;
GRANT SELECT ON public.vw_abandoned_carts TO authenticated;


