END;
$$;
GRANT EXECUTE ON FUNCTION public.place_order(JSONB, JSONB, TEXT) TO anon, authenticated;


-- ███████████████████████████████████████████████████████████████████████████
-- 7. confirm_payment — CORAÇÃO DA AUTOMAÇÃO (transacional + idempotente)
--    Aceita qualquer rótulo de status (normaliza). Ao virar 'pago' pela 1ª vez:
--    baixa estoque, grava históricos, marca carrinho convertido — tudo numa
--    transação. Se algo falhar, o PostgreSQL desfaz tudo (ROLLBACK).
-- ███████████████████████████████████████████████████████████████████████████
CREATE OR REPLACE FUNCTION public.confirm_payment(
  p_mp_payment_id TEXT,
  p_status        TEXT,
  p_raw           JSONB DEFAULT NULL
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE
  v_tx      public.pix_transactions;
  v_from    TEXT;
  v_new     TEXT;
  v_order   public.orders;
  v_item    RECORD;
  v_balance INTEGER;
BEGIN
  PERFORM set_config('loop.actor', 'webhook', true);

  SELECT * INTO v_tx FROM public.pix_transactions WHERE mp_payment_id = p_mp_payment_id LIMIT 1;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('ok', false, 'reason', 'payment_not_found');
  END IF;

  v_from := public.norm_status(v_tx.status);
  v_new  := public.norm_status(p_status);

  IF v_from = v_new THEN
    RETURN jsonb_build_object('ok', true, 'unchanged', true, 'status', v_new);
  END IF;

  -- não regride um pagamento já aprovado por notificação atrasada (evita baixa dupla)
  IF v_from = 'pago' AND v_new NOT IN ('cancelado','expirado') THEN
    RETURN jsonb_build_object('ok', true, 'ignored', true, 'status', v_from);
  END IF;

  UPDATE public.pix_transactions
     SET status = v_new, raw = COALESCE(p_raw, raw), updated_at = NOW()
   WHERE id = v_tx.id;

  UPDATE public.orders
     SET status  = v_new,
         paid_at = CASE WHEN v_new = 'pago' AND paid_at IS NULL THEN NOW() ELSE paid_at END,
         updated_at = NOW()
   WHERE id = v_tx.order_id
   RETURNING * INTO v_order;

  -- ►► APROVAÇÃO (1ª vez): baixa de estoque + históricos, tudo transacional ◄◄
  IF v_new = 'pago' AND v_from <> 'pago' THEN
    FOR v_item IN SELECT * FROM public.order_items WHERE order_id = v_tx.order_id
    LOOP
      IF v_item.product_id IS NOT NULL THEN
        UPDATE public.products
           SET stock = GREATEST(0, COALESCE(stock,0) - v_item.qty)
         WHERE id = v_item.product_id
         RETURNING stock INTO v_balance;

        INSERT INTO public.inventory_logs (product_id, product_name, change, reason, order_id, balance_after)
        VALUES (v_item.product_id, v_item.product_name, -v_item.qty, 'venda', v_tx.order_id, v_balance);
      END IF;

      INSERT INTO public.sales_history (order_id, order_number, product_id, product_name, qty, unit_price, line_total)
      VALUES (v_tx.order_id, v_order.order_number, v_item.product_id, v_item.product_name,
              v_item.qty, v_item.unit_price, ROUND(v_item.qty * v_item.unit_price, 2));
    END LOOP;

    PERFORM public.log_order_event(v_tx.order_id, 'PIX pago — pagamento confirmado pelo Mercado Pago', 'webhook');
    PERFORM public.log_order_event(v_tx.order_id, 'Estoque atualizado automaticamente', 'sistema');
    PERFORM public.mark_cart_converted(v_order.customer_phone, v_order.cart_token, v_tx.order_id);

    INSERT INTO public.system_logs (level, scope, message, data)
    VALUES ('info', 'pix', 'Pagamento aprovado e estoque baixado',
            jsonb_build_object('order_id', v_tx.order_id, 'order_number', v_order.order_number, 'mp_payment_id', p_mp_payment_id));
  ELSE
    INSERT INTO public.system_logs (level, scope, message, data)
    VALUES ('info', 'pix', 'Status do pagamento atualizado',
            jsonb_build_object('order_id', v_tx.order_id, 'from', v_from, 'to', v_new));
  END IF;

  RETURN jsonb_build_object('ok', true, 'order_id', v_tx.order_id,
                            'order_number', v_order.order_number, 'from', v_from, 'to', v_new);
END;
$$;


-- ███████████████████████████████████████████████████████████████████████████
-- 8. get_payment_status — navegador consulta o status (sempre devolve canônico)
-- ███████████████████████████████████████████████████████████████████████████
DROP FUNCTION IF EXISTS public.get_payment_status(bigint, uuid);
CREATE OR REPLACE FUNCTION public.get_payment_status(
  p_order_id BIGINT, p_token UUID
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE r public.pix_transactions; o public.orders;
BEGIN
  SELECT * INTO r FROM public.pix_transactions
   WHERE order_id = p_order_id AND access_token = p_token
   ORDER BY id DESC LIMIT 1;
  IF NOT FOUND THEN RETURN jsonb_build_object('found', false); END IF;

  SELECT * INTO o FROM public.orders WHERE id = p_order_id;

  RETURN jsonb_build_object(
    'found', true,
    'order_id', r.order_id,
    'order_number', o.order_number,
    'status', public.norm_status(r.status),
    'amount', r.amount,
    'paid_at', o.paid_at,
    'expires_at', r.expires_at
  );
END;
$$;
GRANT EXECUTE ON FUNCTION public.get_payment_status(BIGINT, UUID) TO anon, authenticated;


-- ███████████████████████████████████████████████████████████████████████████
-- 9. admin_set_order_status — ações do painel (Pago, Em separação, Enviado,
--    Concluído, Cancelado). Ajusta o estoque automaticamente:
--      • entrando em estado "vendido" (pago→…): baixa estoque + grava venda
--      • saindo de "vendido" para cancelado/expirado: estorna o estoque
--    Histórico é gravado pelo gatilho. Só ADMIN autenticado pode chamar.
-- ███████████████████████████████████████████████████████████████████████████
CREATE OR REPLACE FUNCTION public.admin_set_order_status(
  p_order_id BIGINT,
  p_status   TEXT,
  p_note     TEXT DEFAULT NULL,
  p_actor    TEXT DEFAULT 'admin'
) RETURNS JSONB
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE
  v_old     TEXT;
  v_new     TEXT;
  v_order   public.orders;
  v_item    RECORD;
  v_balance INTEGER;
  v_was_sold BOOLEAN;
  v_is_sold  BOOLEAN;
  sold_states TEXT[] := ARRAY['pago','em_separacao','enviado','concluido'];
BEGIN
  v_new := public.norm_status(p_status);
  IF v_new NOT IN ('pendente','pago','em_separacao','enviado','concluido','cancelado','expirado') THEN
    RETURN jsonb_build_object('ok', false, 'reason', 'status_invalido');
  END IF;

  SELECT * INTO v_order FROM public.orders WHERE id = p_order_id;
  IF NOT FOUND THEN RETURN jsonb_build_object('ok', false, 'reason', 'order_not_found'); END IF;

  v_old := public.norm_status(v_order.status);
  IF v_old = v_new THEN
    RETURN jsonb_build_object('ok', true, 'unchanged', true, 'status', v_new);
  END IF;

  v_was_sold := v_old = ANY(sold_states);
  v_is_sold  := v_new = ANY(sold_states);

  PERFORM set_config('loop.actor', COALESCE(p_actor,'admin'), true);
  PERFORM set_config('loop.note', COALESCE(p_note,''), true);

  -- entrou em estado vendido (ex.: admin confirma pagamento manual) → baixa estoque
  IF v_is_sold AND NOT v_was_sold THEN
    FOR v_item IN SELECT * FROM public.order_items WHERE order_id = p_order_id
    LOOP
      IF v_item.product_id IS NOT NULL THEN
        UPDATE public.products SET stock = GREATEST(0, COALESCE(stock,0) - v_item.qty)
         WHERE id = v_item.product_id RETURNING stock INTO v_balance;
        INSERT INTO public.inventory_logs (product_id, product_name, change, reason, order_id, balance_after)
        VALUES (v_item.product_id, v_item.product_name, -v_item.qty, 'venda (admin)', p_order_id, v_balance);
      END IF;
      INSERT INTO public.sales_history (order_id, order_number, product_id, product_name, qty, unit_price, line_total)
      VALUES (p_order_id, v_order.order_number, v_item.product_id, v_item.product_name,
              v_item.qty, v_item.unit_price, ROUND(v_item.qty * v_item.unit_price, 2));
    END LOOP;
    PERFORM public.log_order_event(p_order_id, 'Estoque atualizado automaticamente', 'sistema');
  END IF;

  -- saiu de vendido para cancelado/expirado → estorna o estoque
  IF v_was_sold AND NOT v_is_sold THEN
    FOR v_item IN SELECT * FROM public.order_items WHERE order_id = p_order_id
    LOOP
      IF v_item.product_id IS NOT NULL THEN
        UPDATE public.products SET stock = COALESCE(stock,0) + v_item.qty
         WHERE id = v_item.product_id RETURNING stock INTO v_balance;
        INSERT INTO public.inventory_logs (product_id, product_name, change, reason, order_id, balance_after)
        VALUES (v_item.product_id, v_item.product_name, v_item.qty, 'estorno ('||v_new||')', p_order_id, v_balance);
      END IF;
    END LOOP;
    DELETE FROM public.sales_history WHERE order_id = p_order_id;
    PERFORM public.log_order_event(p_order_id, 'Estoque estornado automaticamente', 'sistema');
  END IF;

  UPDATE public.orders
     SET status = v_new,
         paid_at = CASE WHEN v_new = 'pago' AND paid_at IS NULL THEN NOW() ELSE paid_at END,
         updated_at = NOW()
   WHERE id = p_order_id;

  RETURN jsonb_build_object('ok', true, 'order_id', p_order_id, 'from', v_old, 'to', v_new);
END;
$$;
GRANT EXECUTE ON FUNCTION public.admin_set_order_status(BIGINT, TEXT, TEXT, TEXT) TO authenticated;


-- ███████████████████████████████████████████████████████████████████████████
-- 10. expire_pending_pix — expira PIX vencidos (canônico)
-- ███████████████████████████████████████████████████████████████████████████
CREATE OR REPLACE FUNCTION public.expire_pending_pix()
RETURNS INTEGER LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
DECLARE n INTEGER;
BEGIN
  PERFORM set_config('loop.actor', 'sistema (expiração)', true);
  WITH upd AS (
    UPDATE public.pix_transactions
       SET status = 'expirado', updated_at = NOW()
     WHERE public.norm_status(status) = 'pendente'
       AND expires_at IS NOT NULL AND expires_at < NOW()
    RETURNING order_id
  )
  UPDATE public.orders o SET status = 'expirado', updated_at = NOW()
   FROM upd WHERE o.id = upd.order_id AND public.norm_status(o.status) = 'pendente';
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n;
END;
$$;


