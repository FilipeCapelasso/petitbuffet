-- AFTER INSERT: registra criação + cadastra/atualiza o cliente
CREATE OR REPLACE FUNCTION public.trg_order_created()
RETURNS TRIGGER LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
BEGIN
  INSERT INTO public.order_status_history (order_id, from_status, to_status, note, actor)
  VALUES (NEW.id, NULL, NEW.status, 'Pedido criado',
          COALESCE(current_setting('loop.actor', true), 'cliente'));

  IF NULLIF(public.only_digits(NEW.customer_phone),'') IS NOT NULL THEN
    INSERT INTO public.customers (name, phone, first_seen, last_seen)
    VALUES (NEW.customer_name, public.only_digits(NEW.customer_phone), NOW(), NOW())
    ON CONFLICT (phone) DO UPDATE
       SET name = COALESCE(EXCLUDED.name, public.customers.name),
           last_seen = NOW();
  END IF;
  RETURN NEW;
END;
$$;
