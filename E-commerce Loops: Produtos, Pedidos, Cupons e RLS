-- ███████████████████████████████████████████████████████████████████████████
-- 1. STATUS OFICIAIS + NORMALIZADOR
--    Converte QUALQUER rótulo (Mercado Pago, versões antigas, PT/EN) para um
--    dos 7 status canônicos. É a "ponte" que mantém tudo compatível.
-- ███████████████████████████████████████████████████████████████████████████
CREATE OR REPLACE FUNCTION public.norm_status(p TEXT)
RETURNS TEXT LANGUAGE sql IMMUTABLE AS $$
  SELECT CASE lower(trim(coalesce(p,'')))
    WHEN ''                      THEN 'pendente'
    -- PENDENTE
    WHEN 'pendente'              THEN 'pendente'
    WHEN 'pending'               THEN 'pendente'
    WHEN 'in_process'            THEN 'pendente'
    WHEN 'in_mediation'          THEN 'pendente'
    WHEN 'authorized'            THEN 'pendente'
    WHEN 'aguardando_pagamento'  THEN 'pendente'
    WHEN 'aguardando'            THEN 'pendente'
    -- PAGO
    WHEN 'pago'                  THEN 'pago'
    WHEN 'approved'              THEN 'pago'
    WHEN 'accredited'            THEN 'pago'
    WHEN 'paid'                  THEN 'pago'
    WHEN 'aprovado'              THEN 'pago'
    -- EM SEPARAÇÃO
    WHEN 'em_separacao'          THEN 'em_separacao'
    WHEN 'em_separação'          THEN 'em_separacao'
    WHEN 'separacao'             THEN 'em_separacao'
    WHEN 'separating'            THEN 'em_separacao'
    WHEN 'preparing'             THEN 'em_separacao'
    -- ENVIADO
    WHEN 'enviado'               THEN 'enviado'
    WHEN 'shipped'               THEN 'enviado'
    WHEN 'sent'                  THEN 'enviado'
    WHEN 'dispatched'            THEN 'enviado'
    -- CONCLUÍDO
    WHEN 'concluido'             THEN 'concluido'
    WHEN 'concluído'             THEN 'concluido'
    WHEN 'completed'             THEN 'concluido'
    WHEN 'done'                  THEN 'concluido'
    WHEN 'finished'              THEN 'concluido'
    WHEN 'delivered'             THEN 'concluido'
    WHEN 'entregue'              THEN 'concluido'
    -- CANCELADO (inclui rejeitado/estornado)
    WHEN 'cancelado'             THEN 'cancelado'
    WHEN 'cancelled'             THEN 'cancelado'
    WHEN 'canceled'              THEN 'cancelado'
    WHEN 'rejected'              THEN 'cancelado'
    WHEN 'rejeitado'             THEN 'cancelado'
    WHEN 'refunded'              THEN 'cancelado'
    WHEN 'reembolsado'           THEN 'cancelado'
    WHEN 'charged_back'          THEN 'cancelado'
    WHEN 'chargeback'            THEN 'cancelado'
    -- EXPIRADO
    WHEN 'expirado'              THEN 'expirado'
    WHEN 'expired'               THEN 'expirado'
    WHEN 'vencido'               THEN 'expirado'
    ELSE 'pendente'
  END;
$$;


