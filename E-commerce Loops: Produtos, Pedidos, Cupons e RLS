  FOR EACH ROW EXECUTE FUNCTION public.trg_order_created();

-- AFTER UPDATE OF status: registra cada transição
CREATE OR REPLACE FUNCTION public.trg_order_status_changed()
RETURNS TRIGGER LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
BEGIN
  IF NEW.status IS DISTINCT FROM OLD.status THEN
    INSERT INTO public.order_status_history (order_id, from_status, to_status, note, actor)
    VALUES (NEW.id, OLD.status, NEW.status,
            NULLIF(current_setting('loop.note', true), ''),
            COALESCE(current_setting('loop.actor', true), 'sistema'));
  END IF;
  RETURN NEW;
END;
$$;
DROP TRIGGER IF EXISTS trg_orders_status_changed ON public.orders;
CREATE TRIGGER trg_orders_status_changed
  AFTER UPDATE OF status ON public.orders
  FOR EACH ROW EXECUTE FUNCTION public.trg_order_status_changed();

